const g = id => document.getElementById(id);
function toast(msg, dur=2200){
  const t=g('toast');t.textContent=msg;t.style.display='block';
  setTimeout(()=>t.style.display='none',dur);
}
function rp(n){return'Rp '+Math.round(n).toLocaleString('id-ID');}
function showScreen(id){
  document.querySelectorAll('.scr').forEach(s=>s.classList.remove('on'));
  g(id).classList.add('on');
}
function swTab(role,panel,btn){
  const prefix = role==='staff' ? 's-' : 'k-';
  document.querySelectorAll(`#sc-${role} .panel`).forEach(p=>p.classList.remove('on'));
  document.querySelectorAll(`#tabs-${role} .tbtn`).forEach(b=>b.classList.remove('on'));
  g(prefix+panel).classList.add('on');
  btn.classList.add('on');
}
function logout(){
  pinStaffStr='';pinKanitStr='';
  showScreen('sc-login');
}

// ════════════════════════════════════════════════════════════
// PIN AUTH
// ════════════════════════════════════════════════════════════
const PIN_STAFF_CORRECT = '777888';
const PIN_KANIT_CORRECT = '888888';
let pinStaffStr = '';
let pinKanitStr = '';

function pinStaff(d){
  if(pinStaffStr.length>=6)return;
  pinStaffStr+=d;
  updateDots('pds',pinStaffStr.length);
  if(pinStaffStr.length===6)setTimeout(cekPinStaff,150);
}
function delPinStaff(){pinStaffStr=pinStaffStr.slice(0,-1);updateDots('pds',pinStaffStr.length);}
function updateDots(pre,n){for(let i=0;i<6;i++)g(pre+i).classList.toggle('on',i<n);}

function cekPinStaff(){
  const nama=g('si-nama').value.trim();
  const shift=g('si-shift').value;
  const lok=g('si-lokasi').value.trim();
  if(!nama){g('pin-err-staff').textContent='Nama wajib diisi!';pinStaffStr='';updateDots('pds',0);return;}
  if(!shift){g('pin-err-staff').textContent='Pilih shift dulu!';pinStaffStr='';updateDots('pds',0);return;}
  if(pinStaffStr!==PIN_STAFF_CORRECT){
    g('pin-err-staff').textContent='PIN salah, coba lagi.';
    pinStaffStr='';updateDots('pds',0);return;
  }
  g('s-hdr-nama').textContent=nama;
  g('s-hdr-sub').textContent=`Shift ${shift} · ${lok||'—'} · ${new Date().toLocaleDateString('id-ID')}`;
  showScreen('sc-staff');
  // Match nama ke karyawan leaderboard untuk view personal
  const matchKey = Object.keys(LB_NAMES).find(k=>LB_NAMES[k].toLowerCase()===nama.toLowerCase());
  lbCurrentStaffKey = matchKey || null;
  pinStaffStr='';updateDots('pds',0);
}

function bukaKanit(){showScreen('sc-pin-kanit');}
function pinKanit(d){
  if(pinKanitStr.length>=6)return;
  pinKanitStr+=d;
  updateDots('pdk',pinKanitStr.length);
  if(pinKanitStr.length===6)setTimeout(cekPinKanit,150);
}
function delPinKanit(){pinKanitStr=pinKanitStr.slice(0,-1);updateDots('pdk',pinKanitStr.length);}
function cekPinKanit(){
  if(pinKanitStr!==PIN_KANIT_CORRECT){
    g('pin-err-kanit').textContent='PIN salah!';
    pinKanitStr='';updateDots('pdk',0);return;
  }
  g('k-hdr-sub').textContent=new Date().toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long'});
  showScreen('sc-kanit');
  pinKanitStr='';updateDots('pdk',0);
}

// ════════════════════════════════════════════════════════════
