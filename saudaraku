// ════════════════════════════════════════════════════════════
// ══════════ LEADERBOARD ENGINE ══════════
// ════════════════════════════════════════════════════════════

// ── State ──
let LB_TARGETS = {
  senior: { tf:750, tt:875, voucher:2500, acc:0, hp:4, label:'Senior Operational', cabang:'C1 (Pusat)', reward:300000, periode:'bulanan' },
  pram_c1: { tf:120, tt:120, voucher:600, acc:0, hp:2, label:'Pramuniaga C1', cabang:'Cabang 1', reward:0, periode:'2minggu' },
  pram_c2: { tf:72, tt:72, voucher:60, acc:25, hp:0, label:'Pramuniaga C2', cabang:'Cabang 2', reward:0, periode:'2minggu' },
  pram_c3: { tf:96, tt:96, voucher:84, acc:48, hp:4, label:'Pramuniaga C3', cabang:'Cabang 3', reward:200000, periode:'2minggu' },
};

let LB_NAMES = {
  senior: 'Senior',
  pram_c1: 'Pramuniaga C1',
  pram_c2: 'Pramuniaga C2',
  pram_c3: 'Pramuniaga C3',
};

let LB_CABANG = {
  senior: 'Cabang 1 (Pusat)',
  pram_c1: 'Cabang 1',
  pram_c2: 'Cabang 2',
  pram_c3: 'Cabang 3',
};

let LB_ACTUAL = {
  senior: { tf:412, tt:480, voucher:1380, acc:0, hp:2 },
  pram_c1: { tf:58, tt:62, voucher:290, acc:0, hp:1 },
  pram_c2: { tf:30, tt:28, voucher:32, acc:10, hp:0 },
  pram_c3: { tf:52, tt:60, voucher:48, acc:22, hp:2 },
};

let LB_BRAND = 'SAUDARA CELL';
let LB_PERIODS = { pram:'1–14 Mei 2025', senior:'Mei 2025', hari:'6 / 14' };
let LB_WHITELIST = [];
let lbCurrentStaffKey = null; // key leaderboard untuk staff login

const LB_COLORS = ['#f5c842','#3ecf8e','#4a9eff','#ff6080','#9b59b6','#f5a623','#e03050','#1abc9c'];
const LB_FILL_CLASSES = {
  senior:'lpf-gold', pram_c1:'lpf-green', pram_c2:'lpf-blue', pram_c3:'lpf-red'
};
let lbColorIdx = 4;

// ── Load from localStorage ──
function lbLoad(){
  try {
    const saved = localStorage.getItem('lb_data');
    if(saved){
      const d = JSON.parse(saved);
      if(d.targets) LB_TARGETS = d.targets;
      if(d.names) LB_NAMES = d.names;
      if(d.cabang) LB_CABANG = d.cabang;
      if(d.actual) LB_ACTUAL = d.actual;
      if(d.brand) LB_BRAND = d.brand;
      if(d.periods) LB_PERIODS = d.periods;
      if(d.whitelist) LB_WHITELIST = d.whitelist;
    }
  } catch(e){}
}

function lbSave(){
  try {
    localStorage.setItem('lb_data', JSON.stringify({
      targets:LB_TARGETS, names:LB_NAMES, cabang:LB_CABANG,
      actual:LB_ACTUAL, brand:LB_BRAND, periods:LB_PERIODS, whitelist:LB_WHITELIST
    }));
  } catch(e){}
}

// ── Calculations ──
function lbGetPct(key){
  const t=LB_TARGETS[key], a=LB_ACTUAL[key];
  const metrics=['tf','tt','voucher','acc','hp'].filter(m=>t[m]>0);
  if(!metrics.length)return 0;
  const avg=metrics.reduce((s,m)=>s+Math.min((a[m]/t[m])*100,100),0)/metrics.length;
  return Math.round(avg);
}

function lbGetReward(key){
  const pct=lbGetPct(key), maxR=LB_TARGETS[key].reward;
  if(!maxR) return {amount:0,status:'na',text:'Tidak ada reward periode ini'};
  if(pct>=100) return {amount:maxR,status:'earned',text:'✅ Reward penuh terkunci!'};
  if(pct>=80) return {amount:Math.round(maxR*0.5),status:'partial',text:'🟡 Reward sebagian (80%+ tercapai)'};
  return {amount:0,status:'risk',text:`⚠️ Reward berisiko hangus — capai 80% dulu`};
}

function lbFillClass(key){
  if(LB_FILL_CLASSES[key]) return LB_FILL_CLASSES[key];
  return 'lpf-purple'; // custom
}

function lbSortedKeys(){
  return Object.keys(LB_TARGETS).sort((a,b)=>lbGetPct(b)-lbGetPct(a));
}

// ── Motivation message ──
function lbGetMotivation(){
  const keys=lbSortedKeys();
  const msgs=[];
  keys.forEach(key=>{
    const pct=lbGetPct(key);
    const name=LB_NAMES[key];
    if(pct>=100) msgs.push(`🎉 <strong>${name}</strong> sudah 100%! Reward terkunci!`);
    else if(pct>=80) msgs.push(`⚡ <strong>${name}</strong> di ${pct}% — tinggal sedikit lagi!`);
    else msgs.push(`🔥 <strong>${name}</strong> di ${pct}% — butuh dorongan ${100-pct}% lagi!`);
  });
  const idx=Math.floor(Date.now()/5000)%msgs.length;
  return msgs[idx];
}

// ── Render Podium ──
function lbRenderPodium(containerId, keys){
  const medals=['🥇','🥈','🥉'];
  const rc=['r1','r2','r3'];
  g(containerId).innerHTML=keys.slice(0,3).map((key,i)=>`
    <div class="lb-pod-card ${rc[i]}">
      <div class="lb-pod-medal">${medals[i]}</div>
      <div class="lb-pod-name">${LB_NAMES[key]}</div>
      <div class="lb-pod-cab">${LB_CABANG[key]}</div>
      <div class="lb-pod-pct">${lbGetPct(key)}%</div>
      <div class="lb-pod-sub">KPI Tercapai</div>
    </div>
  `).join('');
}

// ── Render Leaderboard Table ──
function lbRenderTable(bodyId, keys){
  const metLbl={tf:'TF',tt:'TT',voucher:'VP',acc:'ACC',hp:'SHP'};
  g(bodyId).innerHTML=keys.map((key,i)=>{
    const pct=lbGetPct(key);
    const isTop=i===0;
    return `
      <div class="lb-trow" style="animation-delay:${i*0.07}s">
        <div class="lb-rank-num ${isTop?'top':''}">${i+1}</div>
        <div>
          <div class="lb-person-name">${LB_NAMES[key]}</div>
          <div class="lb-person-cab">${LB_CABANG[key]}</div>
          <span class="lb-role-tag ${key==='senior'?'lrt-senior':'lrt-pram'}">${key==='senior'?'Senior':'Pram'}</span>
        </div>
        <div class="lb-stat-cell">${LB_ACTUAL[key].tf}</div>
        <div class="lb-stat-cell">${LB_ACTUAL[key].tt}</div>
        <div class="lb-stat-cell">${LB_ACTUAL[key].voucher}</div>
        <div class="lb-prog-wrap">
          <div class="lb-prog-lbl">${pct}%</div>
          <div class="lb-prog-bar"><div class="lb-prog-fill ${lbFillClass(key)}" style="width:${pct}%"></div></div>
        </div>
      </div>
    `;
  }).join('');
}

// ── Render KPI Grid ──
function lbRenderKPI(containerId, keys){
  const metLbl={tf:'Transfer',tt:'Tartun',voucher:'Voucher',acc:'ACC HP',hp:'Service HP'};
  g(containerId).innerHTML=keys.map(key=>{
    const t=LB_TARGETS[key], a=LB_ACTUAL[key];
    const rows=Object.keys(metLbl).filter(m=>t[m]>0).map(m=>{
      const pct=Math.min(Math.round((a[m]/t[m])*100),100);
      const cls=pct>=100?'great':pct>=80?'ok':'low';
      return `
        <div class="lb-kpi-row">
          <div class="lb-kpi-lbl">${metLbl[m]}</div>
          <div class="lb-kpi-barwrap"><div class="lb-kpi-bar"><div class="lb-kpi-fill ${lbFillClass(key)}" style="width:${pct}%;${pct>=100?'background:var(--green)':''}"></div></div></div>
          <div class="lb-kpi-pct ${cls}">${pct}%</div>
        </div>
        <div style="font-size:9px;color:var(--muted2);font-family:var(--mono);margin-bottom:6px;padding-left:80px">${a[m]} / ${t[m]}</div>
      `;
    }).join('');
    return `
      <div class="lb-kpi-card">
        <div class="lb-kpi-hdr">
          <div class="lb-kpi-name">${LB_NAMES[key]}</div>
          <div class="lb-kpi-periode">${LB_TARGETS[key].periode==='bulanan'?'Bulanan':'2 Minggu'}</div>
        </div>
        ${rows}
        <div class="lb-kpi-overall">Overall: <strong style="color:var(--text)">${lbGetPct(key)}%</strong></div>
      </div>
    `;
  }).join('');
}

// ── Render Reward ──
function lbRenderReward(containerId, keys){
  const html=keys.map(key=>{
    const r=lbGetReward(key);
    if(r.status==='na')return '';
    const cls='lb-rc-'+{earned:'earned',partial:'partial',risk:'risk'}[r.status];
    const pct=lbGetPct(key);
    return `
      <div class="lb-reward-card ${cls}">
        <div class="lb-rc-top">
          <div>
            <div class="lb-rc-person">${LB_NAMES[key]}</div>
            <div style="font-size:10px;color:var(--muted2)">${LB_CABANG[key]} · ${LB_TARGETS[key].periode==='bulanan'?'Bulanan':'Per 2 Minggu'}</div>
          </div>
          <div>
            <div class="lb-rc-amount">${rp(r.amount)}</div>
            <div style="font-size:9px;color:var(--muted2);text-align:right">/ ${rp(LB_TARGETS[key].reward)} max</div>
          </div>
        </div>
        <div class="lb-rc-status">${r.text}</div>
        ${pct<100?`<div class="lb-rc-miss">Kurang ${100-pct}% untuk reward penuh</div>`:''}
        <div class="lb-prog-bar" style="margin-top:8px"><div class="lb-prog-fill ${lbFillClass(key)}" style="width:${Math.min(pct,100)}%"></div></div>
      </div>
    `;
  }).join('');
  g(containerId).innerHTML=html||'<div style="color:var(--muted2);font-size:12px;text-align:center;padding:20px">Belum ada karyawan dengan reward aktif</div>';
}

// ── WA Generator ──
function lbGenerateWA(textElId, keys){
  const today=new Date().toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'});
  let msg=`📊 *REKAP KPI ${LB_BRAND.toUpperCase()}*\n📅 ${today}\n${'─'.repeat(28)}\n\n`;
  keys.forEach(key=>{
    const pct=lbGetPct(key);
    const e=pct>=100?'✅':pct>=80?'🟡':'🔴';
    msg+=`${e} *${LB_NAMES[key]}* (${LB_CABANG[key]})\n`;
    msg+=`   Transfer: ${LB_ACTUAL[key].tf} trx\n`;
    msg+=`   Tartun: ${LB_ACTUAL[key].tt} trx\n`;
    msg+=`   Voucher: ${LB_ACTUAL[key].voucher} trx\n`;
    if(LB_TARGETS[key].acc>0) msg+=`   ACC: ${LB_ACTUAL[key].acc} trx\n`;
    msg+=`   Progress: *${pct}%*\n\n`;
  });
  const leader=lbSortedKeys()[0];
  msg+=`${'─'.repeat(28)}\n🏆 Leader: *${LB_NAMES[leader]}*\n_${LB_BRAND} — Keep Growing! 💪_`;
  g(textElId).textContent=msg;
}

function lbCopyWA(elId){
  const txt=g(elId).textContent;
  navigator.clipboard.writeText(txt).then(()=>toast('✅ Pesan WA tersalin!'));
}

// ── Period Bar Render ──
function lbRenderPeriodBar(pram,senior,hari){
  if(g(pram)) g(pram).textContent=LB_PERIODS.pram;
  if(g(senior)) g(senior).textContent=LB_PERIODS.senior;
  if(g(hari)) g(hari).textContent=LB_PERIODS.hari;
}

// ── Sub-tab switch ──
function lbSubTab(prefix, tab, btn){
  // prefix: 's' = staff, 'k' = kanit
  const prefix_map = { s:['ranking','kpi','reward'], k:['monitor','input','manage','settings'] };
  const tabs = prefix_map[prefix];
  tabs.forEach(t=>{
    const el = g(`${prefix==='s'?'sbt':'kbt'}-${t}`);
    if(el) el.style.display='none';
  });
  document.querySelectorAll(`#${prefix==='s'?'s-board':'k-board'} .lb-stbtn`).forEach(b=>b.classList.remove('on'));
  const target = g(`${prefix==='s'?'sbt':'kbt'}-${tab}`);
  if(target) target.style.display='block';
  btn.classList.add('on');
  // lazy render
  if(prefix==='s'){
    if(tab==='kpi') lbRenderKPI('sb-kpi-grid', lbSortedKeys());
    if(tab==='reward'){ lbRenderReward('sb-reward-list',lbSortedKeys()); lbGenerateWA('sb-wa-text',lbSortedKeys()); }
  } else {
    if(tab==='input') lbRenderInputCards();
    if(tab==='manage') lbRenderManage();
    if(tab==='settings') lbRenderSettings();
    if(tab==='monitor') lbRenderMonitor();
  }
}

// ── Init Staff Board ──
function initLbStaff(){
  lbLoad();
  const keys=lbSortedKeys();
  g('sb-brand').textContent=LB_BRAND;
  lbRenderPeriodBar('sb-period-pram','sb-period-senior','sb-hari-ke');
  g('sb-motivation').innerHTML=lbGetMotivation();
  lbRenderPodium('sb-podium',keys);
  lbRenderTable('sb-lb-body',keys);
  // rotate motivation
  if(window._lbMotInterval) clearInterval(window._lbMotInterval);
  window._lbMotInterval=setInterval(()=>{
    const m=g('sb-motivation'); if(m)m.innerHTML=lbGetMotivation();
    const k=g('kb-motivation'); if(k)k.innerHTML=lbGetMotivation();
  },5000);
}

// ── Init Kanit Board ──
function initLbKanit(){
  lbLoad();
  lbRenderMonitor();
  lbRenderSettings();
}

function lbRenderMonitor(){
  const keys=lbSortedKeys();
  lbRenderPeriodBar('kb-period-pram','kb-period-senior','kb-hari-ke');
  g('kb-motivation').innerHTML=lbGetMotivation();
  lbRenderPodium('kb-podium',keys);
  lbRenderTable('kb-lb-body',keys);
  lbRenderKPI('kb-kpi-grid',keys);
}

// ── Render Input Cards (Kanit) ──
function lbRenderInputCards(){
  const metLbl={tf:'Transfer (trx)',tt:'Tartun (trx)',voucher:'Voucher/Pulsa (trx)',acc:'ACC HP (trx)',hp:'Service HP (unit)'};
  const dotColors={senior:'#f5c842',pram_c1:'#3ecf8e',pram_c2:'#4a9eff',pram_c3:'#ff6080'};
  g('kb-input-cards').innerHTML=Object.keys(LB_TARGETS).map(key=>{
    const t=LB_TARGETS[key], a=LB_ACTUAL[key];
    const dot=dotColors[key]||LB_COLORS[lbColorIdx%LB_COLORS.length];
    const nameField=`
      <div class="lb-inp-field"><label>👤 Nama Karyawan</label><input class="lb-finp" type="text" id="lbi_${key}_name" value="${LB_NAMES[key]}"></div>
      <div class="lb-inp-field"><label>🏪 Nama Cabang</label><input class="lb-finp" type="text" id="lbi_${key}_cabang" value="${LB_CABANG[key]}"></div>
      <div class="divider"></div>
    `;
    const fields=Object.keys(metLbl).filter(m=>t[m]>0).map(m=>`
      <div class="lb-inp-field"><label>${metLbl[m]} (target: ${t[m]})</label>
        <input class="lb-finp" type="number" id="lbi_${key}_${m}" value="${a[m]}" min="0"></div>
    `).join('');
    return `
      <div class="lb-inp-card">
        <div class="lb-inp-title"><div class="lb-inp-dot" style="background:${dot}"></div>${LB_CABANG[key]} — ${LB_NAMES[key]}</div>
        ${nameField}${fields}
        <button class="lb-savebtn gold" onclick="lbSaveOne('${key}')">💾 SIMPAN ${LB_NAMES[key].toUpperCase()}</button>
      </div>
    `;
  }).join('');
}

function lbSaveOne(key){
  const nameEl=g(`lbi_${key}_name`);
  if(nameEl&&nameEl.value.trim()) LB_NAMES[key]=nameEl.value.trim();
  const cabEl=g(`lbi_${key}_cabang`);
  if(cabEl&&cabEl.value.trim()) LB_CABANG[key]=cabEl.value.trim();
  ['tf','tt','voucher','acc','hp'].forEach(m=>{
    const el=g(`lbi_${key}_${m}`);
    if(el) LB_ACTUAL[key][m]=parseInt(el.value)||0;
  });
  lbSave();
  lbRenderMonitor();
  toast(`✅ Data ${LB_NAMES[key]} tersimpan!`);
}

function lbSaveAll(){
  Object.keys(LB_TARGETS).forEach(key=>lbSaveOne(key));
  toast('✅ Semua data leaderboard tersimpan!');
}

// ── Tambah Karyawan ──
function lbTambahKaryawan(){
  const name=g('lb-new-name').value.trim();
  const cabang=g('lb-new-cabang').value.trim();
  const tf=parseInt(g('lb-new-tf').value)||0;
  const tt=parseInt(g('lb-new-tt').value)||0;
  const voucher=parseInt(g('lb-new-voucher').value)||0;
  const acc=parseInt(g('lb-new-acc').value)||0;
  const hp=parseInt(g('lb-new-hp').value)||0;
  const reward=parseInt(g('lb-new-reward').value)||0;
  const periode=g('lb-new-periode').value;
  if(!name||!cabang){toast('❗ Nama dan cabang wajib diisi!');return;}
  const key='custom_'+Date.now();
  LB_TARGETS[key]={tf,tt,voucher,acc,hp,label:name,cabang,reward,periode};
  LB_NAMES[key]=name;
  LB_CABANG[key]=cabang;
  LB_ACTUAL[key]={tf:0,tt:0,voucher:0,acc:0,hp:0};
  ['lb-new-name','lb-new-cabang','lb-new-tf','lb-new-tt','lb-new-voucher','lb-new-acc','lb-new-hp','lb-new-reward'].forEach(id=>{
    const el=g(id);if(el)el.value='';
  });
  lbSave();
  lbRenderManage();
  lbRenderMonitor();
  toast(`✅ ${name} (${cabang}) ditambahkan!`);
}

function lbHapusKaryawan(key){
  if(!confirm(`Hapus ${LB_NAMES[key]} dari leaderboard?`))return;
  delete LB_TARGETS[key];delete LB_NAMES[key];delete LB_CABANG[key];delete LB_ACTUAL[key];
  lbSave();lbRenderManage();lbRenderMonitor();
  toast('🗑️ Karyawan dihapus.');
}

// ── Manage List ──
function lbRenderManage(){
  const keys=Object.keys(LB_TARGETS);
  if(!keys.length){
    g('kb-manage-list').innerHTML='<div style="color:var(--muted2);font-size:12px;text-align:center;padding:20px">Belum ada karyawan</div>';
    return;
  }
  g('kb-manage-list').innerHTML=keys.map(key=>{
    const pct=lbGetPct(key);
    const isCustom=key.startsWith('custom_');
    return `
      <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:var(--s2);border:1px solid var(--border);border-radius:9px;margin-bottom:6px">
        <div>
          <div style="font-size:13px;font-weight:700">${LB_NAMES[key]}</div>
          <div style="font-size:10px;color:var(--muted2);font-family:var(--mono)">${LB_CABANG[key]} · ${LB_TARGETS[key].periode==='bulanan'?'Bulanan':'2 Minggu'} · ${pct}%</div>
        </div>
        ${isCustom?`<button onclick="lbHapusKaryawan('${key}')" class="wl-del">Hapus</button>`:'<span style="font-size:9px;color:var(--muted2)">default</span>'}
      </div>
    `;
  }).join('');
}

// ── Settings ──
function lbRenderSettings(){
  const bi=g('lb-inp-brand');if(bi)bi.placeholder=LB_BRAND;
  const pp=g('lb-inp-period-pram');if(pp)pp.placeholder=LB_PERIODS.pram;
  const ps=g('lb-inp-period-senior');if(ps)ps.placeholder=LB_PERIODS.senior;
  const ph=g('lb-inp-hari-ke');if(ph)ph.placeholder=LB_PERIODS.hari;
  lbRenderWhitelist();
}

function lbSavePengaturan(){
  const bn=g('lb-inp-brand').value.trim(); if(bn) LB_BRAND=bn;
  const pp=g('lb-inp-period-pram').value.trim(); if(pp) LB_PERIODS.pram=pp;
  const ps=g('lb-inp-period-senior').value.trim(); if(ps) LB_PERIODS.senior=ps;
  const ph=g('lb-inp-hari-ke').value.trim(); if(ph) LB_PERIODS.hari=ph;
  lbSave();
  lbRenderMonitor();
  ['lb-inp-brand','lb-inp-period-pram','lb-inp-period-senior','lb-inp-hari-ke'].forEach(id=>{
    const el=g(id);if(el)el.value='';
  });
  toast('✅ Pengaturan tersimpan!');
}

// ── Whitelist ──
function lbRenderWhitelist(){
  const el=g('lb-whitelist-display');
  if(!el)return;
  if(!LB_WHITELIST.length){
    el.innerHTML='<div style="font-size:11px;color:var(--muted2);padding:8px 0">Belum ada nama. Tambahkan dulu.</div>';
    return;
  }
  el.innerHTML=LB_WHITELIST.map((nama,i)=>`
    <div class="wl-item">
      <div style="display:flex;align-items:center;gap:8px">
        <div style="width:6px;height:6px;border-radius:50%;background:var(--green)"></div>
        <span style="font-size:12px;font-weight:500">${nama}</span>
      </div>
      <button class="wl-del" onclick="lbHapusWhitelist(${i})">Hapus</button>
    </div>
  `).join('');
}

function lbTambahWhitelist(){
  const el=g('lb-inp-whitelist');
  const nama=el.value.trim();
  if(!nama)return;
  if(LB_WHITELIST.find(w=>w.toLowerCase()===nama.toLowerCase())){toast('❗ Nama sudah ada!');return;}
  LB_WHITELIST.push(nama);
  el.value='';
  lbSave();lbRenderWhitelist();
  toast(`✅ ${nama} ditambahkan ke whitelist`);
}

function lbHapusWhitelist(idx){
  const nama=LB_WHITELIST[idx];
  if(!confirm(`Hapus "${nama}" dari whitelist?`))return;
  LB_WHITELIST.splice(idx,1);
  lbSave();lbRenderWhitelist();
}

// ── Reset Aktual ──
function lbResetAktual(){
  if(!confirm('Reset semua data aktual ke 0? Target dan nama tidak berubah.'))return;
  Object.keys(LB_ACTUAL).forEach(key=>{
    LB_ACTUAL[key]={tf:0,tt:0,voucher:0,acc:0,hp:0};
  });
  lbSave();lbRenderMonitor();
  toast('🔄 Data aktual direset ke 0!');
}

