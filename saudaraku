<!DOCTYPE html>

<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Saudaraku</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Bebas+Neue&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0810;--s1:#100d18;--s2:#16121f;--s3:#1d1828;
  --border:#2a2040;--border2:#362a52;
  --accent:#e03050;--accent2:#ff6080;--as:rgba(224,48,80,0.1);
  --green:#3ecf8e;--gs:rgba(62,207,142,0.1);
  --orange:#f5a623;--os:rgba(245,166,35,0.1);
  --red:#e03050;--rs:rgba(224,48,80,0.12);
  --blue:#3060c0;--bs:rgba(48,96,192,0.15);
  --yellow:#f5d020;--ys:rgba(245,208,32,0.1);
  --gold:#f5c842;--gold2:#e8a020;
  --purple:#9b59b6;
  --text:#e8e4f0;--muted:#5a5272;--muted2:#8880a8;
  --sans:'Plus Jakarta Sans',sans-serif;
  --mono:'DM Mono',monospace;
  --bebas:'Bebas Neue',sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
body{background:var(--bg);color:var(--text);font-family:var(--sans);min-height:100vh;overflow-x:hidden;}

.scr{display:none;min-height:100vh;flex-direction:column;}
.scr.on{display:flex;}

#sc-login{align-items:center;justify-content:center;padding:28px 20px;
background:radial-gradient(ellipse at 25% 25%,rgba(108,99,255,0.08),transparent 55%),
radial-gradient(ellipse at 80% 75%,rgba(62,207,142,0.05),transparent 50%),var(–bg);}
.login-brand{text-align:center;margin-bottom:40px;}
.login-brand .logo{font-size:42px;margin-bottom:12px;}
.login-brand h1{font-size:26px;font-weight:800;letter-spacing:-0.5px;}
.login-brand h1 span{color:var(–accent2);}
.login-brand p{font-size:11px;color:var(–muted2);font-family:var(–mono);margin-top:6px;}
.role-btn{width:100%;max-width:340px;background:var(–s2);border:1px solid var(–border2);
border-radius:18px;padding:20px;cursor:pointer;margin-bottom:12px;
display:flex;align-items:center;gap:16px;transition:all 0.2s;text-align:left;}
.role-btn:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(0,0,0,0.4);}
.role-btn.staff:hover{border-color:var(–green);}
.role-btn.kanit:hover{border-color:var(–accent);}
.rb-ico{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.rb-title{font-size:15px;font-weight:700;margin-bottom:3px;}
.rb-sub{font-size:11px;color:var(–muted2);}
.rb-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px;}
.tag{font-size:10px;font-weight:600;padding:2px 8px;border-radius:20px;font-family:var(–mono);}

#sc-pin-staff{align-items:center;justify-content:center;padding:24px;background:var(–bg);}
.pin-wrap{width:100%;max-width:320px;}
.pin-hdr{text-align:center;margin-bottom:28px;}
.pin-hdr .ico{font-size:36px;margin-bottom:10px;}
.pin-hdr h2{font-size:18px;font-weight:800;}
.pin-hdr p{font-size:11px;color:var(–muted2);font-family:var(–mono);margin-top:4px;}
.pin-fields{display:flex;flex-direction:column;gap:10px;margin-bottom:20px;}
.finp{width:100%;background:var(–s2);border:1px solid var(–border2);border-radius:10px;
padding:11px 14px;color:var(–text);font-family:var(–mono);font-size:13px;outline:none;transition:border 0.15s;}
.finp:focus{border-color:var(–accent);}
.finp::placeholder{color:var(–muted);}
select.finp{cursor:pointer;}
.pin-dots{display:flex;gap:10px;justify-content:center;margin-bottom:20px;}
.pd{width:13px;height:13px;border-radius:50%;background:var(–border2);transition:all 0.15s;}
.pd.on{background:var(–accent);box-shadow:0 0 10px rgba(108,99,255,0.5);}
.pin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
.pk{background:var(–s2);border:1px solid var(–border2);border-radius:12px;
padding:16px;font-size:18px;font-weight:700;color:var(–text);cursor:pointer;
font-family:var(–sans);transition:all 0.15s;width:100%;}
.pk:hover{background:var(–s3);}
.pk.sm{font-size:12px;color:var(–muted2);}
.pin-err{color:var(–orange);font-size:11px;text-align:center;margin-top:10px;font-family:var(–mono);min-height:16px;}

.app-hdr{background:var(–s1);border-bottom:1px solid var(–border);
padding:12px 16px;display:flex;align-items:center;justify-content:space-between;
position:sticky;top:0;z-index:100;}
.hdr-info{display:flex;align-items:center;gap:8px;}
.role-badge{font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;font-family:var(–mono);}
.role-badge.staff{background:rgba(62,207,142,0.12);color:var(–green);}
.role-badge.kanit{background:rgba(108,99,255,0.12);color:var(–accent2);}
.hdr-name{font-size:14px;font-weight:700;}
.hdr-sub{font-size:10px;color:var(–muted2);font-family:var(–mono);}
.logout-btn{font-size:11px;color:var(–muted2);cursor:pointer;padding:6px 12px;
border:1px solid var(–border);border-radius:8px;background:none;font-family:var(–sans);}

.tabs{background:var(–s1);border-bottom:1px solid var(–border);
display:flex;overflow-x:auto;scrollbar-width:none;padding:0 8px;flex-shrink:0;}
.tabs::-webkit-scrollbar{display:none;}
.tbtn{flex-shrink:0;padding:10px 14px;font-size:11px;font-weight:700;
color:var(–muted);border-bottom:2px solid transparent;cursor:pointer;
white-space:nowrap;background:none;border-top:none;border-left:none;border-right:none;
font-family:var(–sans);transition:all 0.15s;}
.tbtn.on{color:var(–accent2);border-bottom-color:var(–accent);}

.panel{display:none;flex:1;overflow-y:auto;}
.panel.on{display:block;}
.pad{padding:14px;}

.card{background:var(–s2);border:1px solid var(–border);border-radius:14px;padding:16px;margin-bottom:12px;}
.ctit{font-size:10px;font-weight:700;color:var(–muted2);letter-spacing:1px;text-transform:uppercase;margin-bottom:12px;}
.stit{font-size:10px;font-weight:700;color:var(–muted2);letter-spacing:1px;text-transform:uppercase;margin:16px 0 8px;padding-left:2px;}
.rrow{display:flex;justify-content:space-between;align-items:center;padding:7px 0;font-size:13px;border-bottom:1px solid rgba(255,255,255,0.03);}
.rrow:last-child{border-bottom:none;}
.rl{color:var(–muted2);}
.rv{font-family:var(–mono);font-weight:500;}
.divider{height:1px;background:var(–border);margin:10px 0;}
.field{margin-bottom:10px;}
.field label{font-size:11px;color:var(–muted2);display:block;margin-bottom:4px;font-weight:600;}

.bigbtn{background:var(–accent);border:none;border-radius:12px;padding:14px;
color:#fff;font-weight:800;font-size:14px;width:100%;cursor:pointer;
font-family:var(–sans);transition:all 0.15s;}
.bigbtn:hover{opacity:0.9;}
.bigbtn:disabled{opacity:0.4;cursor:not-allowed;}
.bigbtn.green{background:var(–green);color:#000;}
.outbtn{background:transparent;border:1px solid var(–border2);border-radius:10px;
padding:10px;color:var(–muted2);font-size:12px;cursor:pointer;
font-family:var(–sans);width:100%;}
.kstatus{font-size:11px;text-align:center;margin-top:8px;font-family:var(–mono);min-height:16px;}

.qcat{margin-bottom:16px;}
.qcat-title{font-size:10px;font-weight:700;color:var(–muted2);letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;}
.qgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
.qbtn{background:var(–s3);border:1px solid var(–border2);border-radius:12px;
padding:14px 8px;cursor:pointer;text-align:center;transition:all 0.15s;font-family:var(–sans);}
.qbtn:hover{transform:translateY(-1px);border-color:var(–accent);}
.qbtn .qico{font-size:20px;margin-bottom:5px;}
.qbtn .qlbl{font-size:10px;font-weight:700;color:var(–muted2);}

.scan-bar{display:flex;gap:8px;margin-bottom:10px;}
.scan-inp{flex:1;background:var(–s2);border:1px solid var(–border2);border-radius:10px;
padding:11px 14px;color:var(–text);font-family:var(–mono);font-size:13px;outline:none;}
.scan-inp:focus{border-color:var(–green);}
.scan-inp::placeholder{color:var(–muted);}
.add-btn{background:var(–green);border:none;border-radius:10px;padding:0 16px;
color:#000;font-weight:800;font-size:18px;cursor:pointer;flex-shrink:0;}

.found-card{background:var(–s3);border:1px solid var(–green);border-radius:12px;
padding:12px;display:flex;align-items:center;gap:12px;margin-bottom:10px;
animation:fadeUp 0.2s ease;}
@keyframes fadeUp{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.found-ico{width:38px;height:38px;background:rgba(62,207,142,0.1);border-radius:10px;
display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;}
.found-name{font-size:13px;font-weight:700;}
.found-code{font-size:10px;color:var(–muted2);font-family:var(–mono);margin-top:2px;}
.found-jual{font-size:14px;font-weight:700;color:var(–green);font-family:var(–mono);}

.qmodal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.85);
z-index:500;align-items:flex-end;justify-content:center;padding:0;}
.qmodal.on{display:flex;}
.qmodal-box{background:var(–s2);border:1px solid var(–border2);border-radius:20px 20px 0 0;
padding:24px 20px;width:100%;max-width:480px;animation:slideUp 0.25s ease;}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:none}}
.qmodal-title{font-size:16px;font-weight:800;margin-bottom:6px;}
.qmodal-sub{font-size:11px;color:var(–muted2);font-family:var(–mono);margin-bottom:20px;}
.qmodal-close{position:absolute;top:20px;right:20px;background:var(–s3);border:none;
border-radius:50%;width:32px;height:32px;color:var(–muted2);cursor:pointer;font-size:16px;}

.cart-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(–border);}
.ci-info{flex:1;}
.ci-name{font-size:13px;font-weight:600;}
.ci-sub{font-size:10px;color:var(–muted2);font-family:var(–mono);margin-top:2px;}
.qty-wrap{display:flex;align-items:center;gap:8px;}
.qb{width:28px;height:28px;border-radius:8px;border:1px solid var(–border2);
background:var(–s3);color:var(–text);font-size:15px;cursor:pointer;}
.ci-total{font-family:var(–mono);font-size:12px;color:var(–green);font-weight:700;min-width:80px;text-align:right;}

.rekon-card{border-radius:14px;padding:16px;margin-bottom:10px;}
.rekon-ok{background:var(–gs);border:1px solid rgba(62,207,142,0.3);}
.rekon-warn{background:var(–os);border:1px solid rgba(245,166,35,0.3);}
.rekon-danger{background:var(–rs);border:1px solid rgba(245,99,66,0.3);}
.rekon-lbl{font-size:11px;font-weight:700;letter-spacing:0.5px;}
.rekon-val{font-size:22px;font-weight:800;font-family:var(–mono);margin:4px 0 2px;}
.rekon-sub{font-size:10px;font-family:var(–mono);}

.dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;}
.dcard{background:var(–s2);border:1px solid var(–border);border-radius:12px;padding:14px;}
.dc-lbl{font-size:9px;color:var(–muted2);font-family:var(–mono);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;}
.dc-val{font-size:18px;font-weight:800;font-family:var(–mono);}
.dc-sub{font-size:10px;color:var(–muted2);margin-top:4px;}

.pool-total{background:linear-gradient(135deg,rgba(245,208,32,0.1),rgba(108,99,255,0.08));
border:1px solid rgba(245,208,32,0.3);border-radius:16px;padding:20px;margin-bottom:12px;text-align:center;}
.pool-lbl{font-size:10px;color:var(–yellow);font-family:var(–mono);letter-spacing:1px;text-transform:uppercase;}
.pool-val{font-size:32px;font-weight:800;font-family:var(–mono);color:var(–yellow);margin:6px 0;}
.pool-sub{font-size:11px;color:var(–muted2);}
.buffer-card{border-radius:12px;padding:14px;display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;}
.buffer-ok{background:var(–gs);border:1px solid rgba(62,207,142,0.3);}
.buffer-warn{background:var(–rs);border:1px solid rgba(245,99,66,0.3);}

.laba-item{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(–border);}
.li-left{flex:1;}
.li-cat{font-size:13px;font-weight:600;}
.li-detail{font-size:10px;color:var(–muted2);font-family:var(–mono);margin-top:2px;}
.li-laba{font-family:var(–mono);font-weight:700;color:var(–yellow);font-size:14px;}

.fee-item{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(–border);}
.fee-lbl{font-size:12px;flex:1;}
.fee-inp{background:var(–s3);border:1px solid var(–border2);border-radius:8px;
padding:6px 10px;color:var(–text);font-family:var(–mono);font-size:13px;
width:110px;text-align:right;outline:none;}
.fee-inp:focus{border-color:var(–accent);}

.cab-pool{background:var(–s2);border:1px solid var(–border);border-radius:12px;padding:14px;margin-bottom:10px;}
.cab-pool-hdr{display:flex;align-items:center;gap:8px;margin-bottom:12px;}
.cab-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.cab-pool-name{font-size:13px;font-weight:700;}
.cab-np{background:var(–s3);border-radius:10px;padding:10px 14px;display:flex;justify-content:space-between;margin-top:10px;}
.np-lbl{font-size:11px;color:var(–muted2);}
.np-val{font-family:var(–mono);font-weight:700;font-size:15px;}

/* HR */
.hr-menu-btn{background:var(–s2);border:1px solid var(–border);border-radius:14px;
padding:16px 8px;cursor:pointer;text-align:center;transition:all 0.15s;}
.hr-menu-btn:hover,.hr-menu-btn:active{transform:scale(0.97);border-color:var(–accent);}
.hr-ico{font-size:26px;margin-bottom:6px;}
.hr-lbl{font-size:11px;font-weight:700;color:var(–muted2);}
.hr-panel-hdr{font-size:13px;font-weight:700;color:var(–accent2);cursor:pointer;
padding:8px 0 14px;display:flex;align-items:center;gap:6px;}
.absen-entry{background:var(–s3);border-radius:10px;padding:10px 12px;margin-bottom:6px;
display:flex;align-items:center;gap:10px;}
.absen-time{font-family:var(–mono);font-size:14px;font-weight:700;min-width:54px;}
.slip-row{display:flex;justify-content:space-between;padding:7px 0;
font-size:13px;border-bottom:1px solid rgba(255,255,255,0.03);}
.slip-lbl{color:var(–muted2);}
.slip-val{font-family:var(–mono);font-weight:600;}

#toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);
background:var(–s2);border:1px solid var(–green);border-radius:14px;
padding:10px 20px;font-size:13px;color:var(–green);font-weight:600;
z-index:9999;display:none;white-space:nowrap;box-shadow:0 8px 32px rgba(0,0,0,0.5);}

#mot-modal{position:fixed;inset:0;background:rgba(0,0,0,0.88);
display:none;align-items:center;justify-content:center;padding:24px;z-index:9998;}
#mot-modal.on{display:flex;}
.mot-box{background:var(–s2);border:1px solid var(–border2);border-radius:24px;
padding:36px 28px;max-width:340px;width:100%;text-align:center;}
.mot-emo{font-size:52px;margin-bottom:16px;}
.mot-txt{font-size:14px;line-height:1.9;color:var(–text);margin-bottom:24px;text-align:left;white-space:pre-line;}

.cg{color:var(–green)!important;}.co{color:var(–orange)!important;}
.cr{color:var(–red)!important;}.cb{color:var(–blue)!important;}
.cy{color:var(–yellow)!important;}.cp{color:var(–accent2)!important;}

/* ══════════════════════════════════
LEADERBOARD STYLES
══════════════════════════════════ */
.lb-page-header{
font-family:var(–bebas);
font-size:20px;letter-spacing:3px;color:var(–gold);
margin-bottom:4px;
}
.lb-period-bar{
display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;
}
.lb-period-chip{
background:var(–s3);border:1px solid var(–border);
padding:5px 12px;border-radius:7px;font-size:10px;
color:var(–muted2);font-family:var(–mono);
}
.lb-period-chip span{color:var(–text);font-weight:600;}

.lb-motivation{
background:linear-gradient(135deg,rgba(245,200,66,0.08),rgba(245,200,66,0.02));
border:1px solid rgba(245,200,66,0.2);border-left:3px solid var(–gold);
padding:10px 14px;border-radius:8px;margin-bottom:14px;
font-size:12px;color:var(–gold);font-weight:500;
animation:fadeInLb 0.5s ease;
}
@keyframes fadeInLb{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}

/* Podium */
.lb-podium{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px;}
.lb-pod-card{
background:var(–s2);border:1px solid var(–border);border-radius:12px;
padding:14px 10px;text-align:center;cursor:pointer;transition:transform 0.2s;
}
.lb-pod-card:hover{transform:translateY(-2px);}
.lb-pod-card.r1{border-color:rgba(245,200,66,0.45);background:linear-gradient(135deg,rgba(245,200,66,0.08),var(–s2));}
.lb-pod-card.r2{border-color:rgba(192,192,192,0.3);}
.lb-pod-card.r3{border-color:rgba(205,127,50,0.3);}
.lb-pod-medal{font-family:var(–bebas);font-size:30px;line-height:1;margin-bottom:3px;}
.r1 .lb-pod-medal{color:var(–gold);}
.r2 .lb-pod-medal{color:#c0c0c0;}
.r3 .lb-pod-medal{color:#cd7f32;}
.lb-pod-name{font-size:11px;font-weight:700;margin-bottom:2px;}
.lb-pod-cab{font-size:9px;color:var(–muted2);font-family:var(–mono);margin-bottom:6px;}
.lb-pod-pct{font-family:var(–bebas);font-size:24px;color:var(–gold);}
.lb-pod-sub{font-size:9px;color:var(–muted2);text-transform:uppercase;letter-spacing:1px;}

/* Table */
.lb-table{background:var(–s2);border:1px solid var(–border);border-radius:12px;overflow:hidden;margin-bottom:14px;}
.lb-thead{
display:grid;grid-template-columns:38px 1fr 60px 60px 60px 80px;
padding:9px 12px;background:var(–s3);border-bottom:1px solid var(–border);
font-size:9px;color:var(–muted2);letter-spacing:1.2px;text-transform:uppercase;font-weight:700;
}
.lb-trow{
display:grid;grid-template-columns:38px 1fr 60px 60px 60px 80px;
padding:11px 12px;border-bottom:1px solid rgba(255,255,255,0.03);
align-items:center;cursor:pointer;transition:background 0.15s;
animation:lbSlide 0.35s ease both;
}
.lb-trow:last-child{border-bottom:none;}
.lb-trow:hover{background:var(–s3);}
@keyframes lbSlide{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:none}}
.lb-rank-num{font-family:var(–bebas);font-size:18px;color:var(–muted2);text-align:center;}
.lb-rank-num.top{color:var(–gold);}
.lb-person-name{font-size:12px;font-weight:700;}
.lb-person-cab{font-size:9px;color:var(–muted2);font-family:var(–mono);margin-top:1px;}
.lb-role-tag{display:inline-block;padding:1px 5px;border-radius:4px;font-size:8px;font-weight:700;letter-spacing:0.8px;text-transform:uppercase;margin-top:2px;}
.lrt-senior{background:rgba(245,200,66,0.15);color:var(–gold);}
.lrt-pram{background:rgba(62,207,142,0.12);color:var(–green);}
.lb-stat-cell{font-family:var(–mono);font-size:11px;font-weight:600;text-align:center;color:var(–text);}
.lb-prog-wrap{display:flex;flex-direction:column;gap:2px;}
.lb-prog-lbl{font-size:9px;color:var(–muted2);text-align:right;font-family:var(–mono);}
.lb-prog-bar{height:5px;background:var(–border);border-radius:3px;overflow:hidden;}
.lb-prog-fill{height:100%;border-radius:3px;transition:width 1.2s cubic-bezier(.4,0,.2,1);}
.lpf-gold{background:linear-gradient(90deg,var(–gold2),var(–gold));}
.lpf-green{background:linear-gradient(90deg,#27ae60,var(–green));}
.lpf-blue{background:linear-gradient(90deg,#1a4080,var(–blue));}
.lpf-red{background:linear-gradient(90deg,#8b1a2b,var(–red));}
.lpf-purple{background:linear-gradient(90deg,#5a1f7a,var(–purple));}

/* KPI detail cards */
.lb-kpi-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;}
.lb-kpi-card{background:var(–s2);border:1px solid var(–border);border-radius:12px;padding:14px;}
.lb-kpi-hdr{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;}
.lb-kpi-name{font-size:12px;font-weight:700;}
.lb-kpi-periode{font-size:9px;color:var(–muted2);font-family:var(–mono);
background:var(–s3);padding:2px 7px;border-radius:4px;}
.lb-kpi-row{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
.lb-kpi-lbl{font-size:10px;color:var(–muted2);width:72px;flex-shrink:0;}
.lb-kpi-barwrap{flex:1;}
.lb-kpi-bar{height:7px;background:var(–border);border-radius:3px;overflow:hidden;}
.lb-kpi-fill{height:100%;border-radius:3px;transition:width 1.3s cubic-bezier(.4,0,.2,1);}
.lb-kpi-pct{font-size:10px;font-family:var(–mono);font-weight:600;width:34px;text-align:right;flex-shrink:0;}
.lb-kpi-pct.great{color:var(–green);}
.lb-kpi-pct.ok{color:var(–gold);}
.lb-kpi-pct.low{color:var(–red);}
.lb-kpi-overall{font-size:10px;color:var(–muted2);margin-top:6px;padding-top:6px;border-top:1px solid var(–border);}

/* Reward cards */
.lb-reward-card{background:var(–s2);border:1px solid var(–border);border-radius:12px;padding:14px;margin-bottom:10px;position:relative;overflow:hidden;}
.lb-reward-card::before{content:’’;position:absolute;top:0;left:0;right:0;height:3px;}
.lb-rc-earned::before{background:var(–green);}
.lb-rc-partial::before{background:var(–gold);}
.lb-rc-risk::before{background:var(–red);}
.lb-rc-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px;}
.lb-rc-person{font-size:13px;font-weight:700;}
.lb-rc-amount{font-family:var(–bebas);font-size:24px;line-height:1;}
.lb-rc-earned .lb-rc-amount{color:var(–green);}
.lb-rc-partial .lb-rc-amount{color:var(–gold);}
.lb-rc-risk .lb-rc-amount{color:var(–red);}
.lb-rc-status{font-size:11px;padding:5px 9px;border-radius:6px;font-weight:500;margin-bottom:8px;}
.lb-rc-earned .lb-rc-status{background:rgba(62,207,142,0.1);color:var(–green);}
.lb-rc-partial .lb-rc-status{background:rgba(245,200,66,0.1);color:var(–gold);}
.lb-rc-risk .lb-rc-status{background:rgba(224,48,80,0.1);color:var(–red);}
.lb-rc-miss{font-size:10px;color:var(–muted2);font-family:var(–mono);}

/* WA Preview */
.lb-wa-box{background:#1a2a1a;border:1px solid rgba(62,207,142,0.2);border-radius:12px;
padding:16px;margin-bottom:14px;font-family:var(–mono);font-size:11px;
line-height:1.8;color:#a0d4a0;white-space:pre-wrap;}
.lb-wa-hdr{font-size:10px;color:var(–green);letter-spacing:1px;text-transform:uppercase;
margin-bottom:10px;font-family:var(–sans);font-weight:700;display:flex;justify-content:space-between;align-items:center;}
.lb-copy-btn{background:rgba(62,207,142,0.15);border:1px solid rgba(62,207,142,0.3);
color:var(–green);padding:3px 10px;border-radius:5px;font-size:10px;cursor:pointer;
font-family:var(–sans);transition:all 0.15s;}
.lb-copy-btn:hover{background:rgba(62,207,142,0.25);}

/* Kanit input */
.lb-inp-card{background:var(–s2);border:1px solid var(–border);border-radius:12px;padding:14px;margin-bottom:10px;}
.lb-inp-title{font-size:10px;font-weight:700;color:var(–muted2);letter-spacing:1px;text-transform:uppercase;margin-bottom:12px;display:flex;align-items:center;gap:7px;}
.lb-inp-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.lb-inp-field{margin-bottom:9px;}
.lb-inp-field label{font-size:10px;color:var(–muted2);display:block;margin-bottom:3px;font-weight:600;}
.lb-finp{width:100%;background:var(–bg);border:1px solid var(–border);border-radius:7px;
padding:8px 10px;color:var(–text);font-family:var(–mono);font-size:12px;outline:none;transition:border 0.15s;}
.lb-finp:focus{border-color:var(–gold);}
.lb-savebtn{width:100%;padding:10px;border-radius:9px;border:none;font-family:var(–bebas);
font-size:15px;letter-spacing:2px;cursor:pointer;margin-top:10px;transition:all 0.15s;}
.lb-savebtn:hover{filter:brightness(1.1);}
.lb-savebtn.gold{background:var(–gold);color:var(–bg);}
.lb-savebtn.green{background:var(–green);color:#000;}
.lb-savebtn.purple{background:var(–purple);color:#fff;}

/* Sub-tabs for leaderboard */
.lb-subtabs{display:flex;gap:4px;margin-bottom:14px;background:var(–s2);
padding:3px;border-radius:9px;border:1px solid var(–border);}
.lb-stbtn{flex:1;padding:7px;border-radius:6px;border:none;background:transparent;
color:var(–muted2);font-family:var(–sans);font-size:11px;font-weight:600;cursor:pointer;transition:all 0.15s;}
.lb-stbtn.on{background:var(–s3);color:var(–text);}

/* Neuro tip */
.lb-neuro-tip{background:linear-gradient(135deg,rgba(155,89,182,0.08),rgba(74,158,255,0.05));
border:1px solid rgba(155,89,182,0.2);border-radius:10px;padding:14px;
font-size:11px;color:var(–muted2);line-height:1.7;margin-bottom:14px;}
.lb-neuro-tip strong{color:var(–purple);}

/* Whitelist display */
.wl-item{display:flex;align-items:center;justify-content:space-between;
padding:7px 10px;background:var(–bg);border:1px solid var(–border);
border-radius:7px;margin-bottom:5px;}
.wl-del{background:rgba(224,48,80,0.12);border:1px solid rgba(224,48,80,0.25);
color:var(–red);padding:2px 8px;border-radius:5px;font-size:10px;cursor:pointer;
font-family:var(–sans);}

/* Streak */
.lb-streak-row{display:flex;gap:4px;flex-wrap:wrap;margin-top:6px;}
.lb-sday{width:20px;height:20px;border-radius:4px;display:flex;align-items:center;
justify-content:center;font-size:8px;font-weight:700;font-family:var(–mono);}
.lb-sday.hit{background:rgba(62,207,142,0.25);color:var(–green);border:1px solid rgba(62,207,142,0.35);}
.lb-sday.miss{background:rgba(224,48,80,0.12);color:var(–red);border:1px solid rgba(224,48,80,0.2);}
.lb-sday.empty{background:var(–s3);color:var(–muted2);border:1px solid var(–border);}

/* Responsive */
@media(max-width:480px){
.lb-thead,.lb-trow{grid-template-columns:32px 1fr 50px 70px;}
.lb-thead>*:nth-child(3),.lb-thead>*:nth-child(4),
.lb-trow>*:nth-child(3),.lb-trow>*:nth-child(4){display:none;}
.lb-kpi-grid{grid-template-columns:1fr;}
}
</style>

</head>
